      ]
    },
    {
      "name": "IAM Policies & Roles",
      "shortcuts": [
        {
          "command": "aws iam list-policies",
          "description": "List IAM policies"
        },
        {
          "command": "aws iam create-policy --policy-name MyPolicy --policy-document file://policy.json",
          "description": "Create IAM policy"
        },
        {
          "command": "aws iam attach-user-policy --user-name username --policy-arn arn:aws:iam::aws:policy/PolicyName",
          "description": "Attach policy to user"
        },
        {
          "command": "aws iam detach-user-policy --user-name username --policy-arn arn:aws:iam::aws:policy/PolicyName",
          "description": "Detach policy from user"
        },
        {
          "command": "aws iam list-roles",
          "description": "List IAM roles"
        },
        {
          "command": "aws iam create-role --role-name MyRole --assume-role-policy-document file://trust-policy.json",
          "description": "Create IAM role"
        },
        {
          "command": "aws iam attach-role-policy --role-name MyRole --policy-arn arn:aws:iam::aws:policy/PolicyName",
          "description": "Attach policy to role"
        }
      ]
    },
