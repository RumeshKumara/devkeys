{
  "categories": [
    {
      "name": "Configuration",
      "shortcuts": [
        {
          "command": "aws configure",
          "description": "Configure AWS CLI settings"
        },
        {
          "command": "aws configure list",
          "description": "List current configuration"
        },
        {
          "command": "aws configure get <variable>",
          "description": "Get specific config value"
        },
        {
          "command": "aws configure set <variable> <value>",
          "description": "Set config value"
        },
        {
          "command": "aws configure --profile <name>",
          "description": "Configure named profile"
        },
        {
          "command": "aws sts get-caller-identity",
          "description": "Get current user/role identity"
        }
      ]
    },
    {
      "name": "S3 Operations",
      "shortcuts": [
        {
          "command": "aws s3 ls",
          "description": "List all S3 buckets"
        },
        {
          "command": "aws s3 ls s3://bucket-name",
          "description": "List contents of a bucket"
        },
        {
          "command": "aws s3 ls s3://bucket-name/path/",
          "description": "List contents of a folder"
        },
        {
          "command": "aws s3 cp file.txt s3://bucket-name/",
          "description": "Copy file to S3"
        },
        {
          "command": "aws s3 cp s3://bucket-name/file.txt .",
          "description": "Download file from S3"
        },
        {
          "command": "aws s3 sync . s3://bucket-name/",
          "description": "Sync local directory to S3"
        },
        {
          "command": "aws s3 sync s3://bucket-name/ .",
          "description": "Sync S3 to local directory"
        },
        {
          "command": "aws s3 rm s3://bucket-name/file.txt",
          "description": "Delete file from S3"
        },
        {
          "command": "aws s3 rm s3://bucket-name/ --recursive",
          "description": "Delete all files in bucket"
        },
        {
          "command": "aws s3 mv s3://bucket/old.txt s3://bucket/new.txt",
          "description": "Move/rename file in S3"
        },
        {
          "command": "aws s3 mb s3://bucket-name",
          "description": "Create S3 bucket"
        },
        {
          "command": "aws s3 rb s3://bucket-name",
          "description": "Remove empty bucket"
        },
        {
          "command": "aws s3 rb s3://bucket-name --force",
          "description": "Remove bucket and all contents"
        },
        {
          "command": "aws s3 presign s3://bucket-name/file.txt",
          "description": "Generate presigned URL"
        }
      ]
    },
    {
      "name": "EC2 Instances",
      "shortcuts": [
        {
          "command": "aws ec2 describe-instances",
          "description": "List all EC2 instances"
        },
        {
          "command": "aws ec2 describe-instances --instance-ids i-xxxxx",
          "description": "Describe specific instance"
        },
        {
          "command": "aws ec2 start-instances --instance-ids i-xxxxx",
          "description": "Start EC2 instance"
        },
        {
          "command": "aws ec2 stop-instances --instance-ids i-xxxxx",
          "description": "Stop EC2 instance"
        },
        {
          "command": "aws ec2 reboot-instances --instance-ids i-xxxxx",
          "description": "Reboot EC2 instance"
        },
        {
          "command": "aws ec2 terminate-instances --instance-ids i-xxxxx",
          "description": "Terminate EC2 instance"
        },
        {
          "command": "aws ec2 run-instances --image-id ami-xxxxx --instance-type t2.micro",
          "description": "Launch new EC2 instance"
        },
        {
          "command": "aws ec2 describe-instance-status",
          "description": "Check instance status"
        },
        {
          "command": "aws ec2 create-tags --resources i-xxxxx --tags Key=Name,Value=MyInstance",
          "description": "Tag EC2 instance"
        }
      ]
    },
    {
      "name": "EC2 Key Pairs & Security Groups",
      "shortcuts": [
        {
          "command": "aws ec2 describe-key-pairs",
          "description": "List all key pairs"
        },
        {
          "command": "aws ec2 create-key-pair --key-name MyKeyPair",
          "description": "Create new key pair"
        },
        {
          "command": "aws ec2 delete-key-pair --key-name MyKeyPair",
          "description": "Delete key pair"
        },
        {
          "command": "aws ec2 describe-security-groups",
          "description": "List security groups"
        },
        {
          "command": "aws ec2 create-security-group --group-name MyGroup --description 'My SG'",
          "description": "Create security group"
        },
        {
          "command": "aws ec2 authorize-security-group-ingress --group-id sg-xxxxx --protocol tcp --port 22 --cidr 0.0.0.0/0",
          "description": "Add inbound rule to security group"
        },
        {
          "command": "aws ec2 revoke-security-group-ingress --group-id sg-xxxxx --protocol tcp --port 22 --cidr 0.0.0.0/0",
          "description": "Remove inbound rule"
        }
      ]
    },
    {
      "name": "EC2 Images (AMI)",
      "shortcuts": [
        {
          "command": "aws ec2 describe-images --owners self",
          "description": "List your AMIs"
        },
        {
          "command": "aws ec2 describe-images --owners amazon --filters 'Name=name,Values=amzn2-ami-hvm-*'",
          "description": "List Amazon Linux AMIs"
        },
        {
          "command": "aws ec2 create-image --instance-id i-xxxxx --name 'My AMI'",
          "description": "Create AMI from instance"
        },
        {
          "command": "aws ec2 deregister-image --image-id ami-xxxxx",
          "description": "Delete AMI"
        }
      ]
    },
    {
      "name": "EC2 Volumes (EBS)",
      "shortcuts": [
        {
          "command": "aws ec2 describe-volumes",
          "description": "List all EBS volumes"
        },
        {
          "command": "aws ec2 create-volume --availability-zone us-east-1a --size 10",
          "description": "Create EBS volume"
        },
        {
          "command": "aws ec2 attach-volume --volume-id vol-xxxxx --instance-id i-xxxxx --device /dev/sdf",
          "description": "Attach volume to instance"
        },
        {
          "command": "aws ec2 detach-volume --volume-id vol-xxxxx",
          "description": "Detach volume"
        },
        {
          "command": "aws ec2 delete-volume --volume-id vol-xxxxx",
          "description": "Delete volume"
        },
        {
          "command": "aws ec2 create-snapshot --volume-id vol-xxxxx",
          "description": "Create volume snapshot"
        },
        {
          "command": "aws ec2 describe-snapshots --owner-ids self",
          "description": "List your snapshots"
        }
      ]
    },
    {
      "name": "IAM Users & Groups",
      "shortcuts": [
        {
          "command": "aws iam list-users",
