        },
        {
          "command": "aws iam delete-user --user-name username",
          "description": "Delete IAM user"
        },
        {
          "command": "aws iam list-groups",
          "description": "List IAM groups"
        },
        {
          "command": "aws iam create-group --group-name groupname",
          "description": "Create IAM group"
        },
        {
          "command": "aws iam add-user-to-group --user-name username --group-name groupname",
          "description": "Add user to group"
        },
        {
          "command": "aws iam remove-user-from-group --user-name username --group-name groupname",
          "description": "Remove user from group"
