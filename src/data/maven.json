{
  "categories": [
    {
      "name": "Build Lifecycle",
      "shortcuts": [
        {
          "command": "mvn clean",
          "description": "Clean the project (delete target directory)"
        },
        {
          "command": "mvn compile",
          "description": "Compile source code"
        },
        {
          "command": "mvn test",
          "description": "Run unit tests"
        },
        {
          "command": "mvn package",
          "description": "Package compiled code (JAR/WAR)"
        },
        {
          "command": "mvn install",
          "description": "Install package to local repository"
        },
        {
          "command": "mvn deploy",
          "description": "Deploy to remote repository"
        },
        {
          "command": "mvn verify",
          "description": "Run integration tests"
        },
        {
          "command": "mvn validate",
          "description": "Validate project structure"
        }
      ]
    },
    {
      "name": "Common Commands",
      "shortcuts": [
        {
          "command": "mvn clean install",
          "description": "Clean and install project"
        },
        {
          "command": "mvn clean package",
          "description": "Clean and package project"
        },
        {
          "command": "mvn clean test",
          "description": "Clean and run tests"
        },
        {
          "command": "mvn clean compile",
          "description": "Clean and compile project"
        },
        {
          "command": "mvn clean install -DskipTests",
          "description": "Install without running tests"
