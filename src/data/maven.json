    {
      "name": "Testing",
      "shortcuts": [
        {
          "command": "mvn test",
          "description": "Run all unit tests"
        },
        {
          "command": "mvn test -Dtest=TestClassName",
          "description": "Run specific test class"
        },
        {
          "command": "mvn test -Dtest=TestClassName#testMethod",
          "description": "Run specific test method"
        },
        {
          "command": "mvn test -Dtest=Test*",
          "description": "Run tests matching pattern"
        },
        {
          "command": "mvn integration-test",
          "description": "Run integration tests"
        },
        {
          "command": "mvn surefire-report:report",
          "description": "Generate test report"
        },
        {
          "command": "mvn test -DfailIfNoTests=false",
          "description": "Run tests without failing if none exist"
        }
      ]
