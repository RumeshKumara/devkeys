    {
      "name": "Project Creation",
      "shortcuts": [
        {
          "command": "mvn archetype:generate",
          "description": "Create new project from archetype"
        },
        {
          "command": "mvn archetype:generate -DgroupId=com.example -DartifactId=myapp -DarchetypeArtifactId=maven-archetype-quickstart -DinteractiveMode=false",
          "description": "Create Java project quickly"
        },
        {
          "command": "mvn archetype:generate -DgroupId=com.example -DartifactId=webapp -DarchetypeArtifactId=maven-archetype-webapp -DinteractiveMode=false",
          "description": "Create web application project"
        }
      ]
