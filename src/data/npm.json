{
  "categories": [
    {
      "name": "Package Installation",
      "shortcuts": [
        {
          "command": "npm install",
          "description": "Install all dependencies from package.json"
        },
        {
          "command": "npm install <package>",
          "description": "Install a package"
        },
        {
          "command": "npm install <package>@<version>",
          "description": "Install specific version of package"
        },
        {
          "command": "npm install <package> --save",
          "description": "Install and add to dependencies"
        },
        {
          "command": "npm install <package> --save-dev",
          "description": "Install and add to devDependencies"
        },
        {
          "command": "npm install <package> -g",
          "description": "Install package globally"
        },
        {
          "command": "npm install <package> --save-exact",
          "description": "Install exact version"
        },
        {
          "command": "npm install --production",
          "description": "Install only production dependencies"
        },
        {
          "command": "npm ci",
          "description": "Clean install from package-lock.json"
        }
      ]
    },
    {
