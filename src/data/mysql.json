        {
          "command": "GRANT ALL PRIVILEGES ON database_name.* TO 'username'@'host';",
          "description": "Grant all privileges"
        },
        {
          "command": "GRANT SELECT, INSERT ON database_name.table_name TO 'username'@'host';",
